# Copy to .env and fill in what you use. Every value here has a default in config/settings.py.

# Backend: groq | no_ai | openai | gemini | local
# A cloud backend without a key raises an error - it never silently falls back to no_ai.
AI_MODE=groq

# --- Groq (primary). Free keys: https://console.groq.com ---------------------------
# Several keys are rotated, but free-tier limits are per ORGANISATION and per model,
# so extra keys from the same org add little throughput.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_VISION_MODEL=qwen/qwen3.8-27b        # scans / photos (page images)
GROQ_TEXT_MODEL=openai/gpt-oss-120b       # digital PDFs (exact text layer)
GROQ_TOKENS_PER_MINUTE=7000               # client-side pacing to stay under the TPM limit
GROQ_REASONING_EFFORT=medium              # gpt-oss only: low | medium | high
ROUTE_DIGITAL_TO_TEXT=true

# --- OpenAI or any OpenAI-compatible gateway ---------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Gemini (via its OpenAI-compatible endpoint) -----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local LLM (Ollama / LM Studio / llama.cpp, OpenAI-compatible) -----------------
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5vl:7b
LOCAL_LLM_API_KEY=local-key
LOCAL_LLM_VISION_ENABLED=true

# --- Pipeline behaviour ------------------------------------------------------------
ARITHMETIC_TOLERANCE=0.05     # sum(items) + tax vs total, in currency units
MAX_RETRIES=2                 # corrective LLM retries when validation fails
REQUEST_TIMEOUT=90
MAX_PAGES=5                   # pages sent to a vision model
MAX_IMAGE_SIDE=1800
MAX_WORKERS=4                 # documents processed in parallel
CACHE_ENABLED=true            # cache results by file hash + model + prompt version
PII_SHIELD_ENABLED=false      # mask bank/card/ID numbers in TEXT sent to cloud models
LOG_LEVEL=INFO
RENDER_DPI=200                # page render resolution for scans
