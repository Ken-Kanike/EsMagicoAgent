# ================================================================
# EsMagico Invoice Extraction Pipeline — Environment Configuration
# Copy this file to .env and configure your keys and endpoints.
# ================================================================

# ---------------------------------------------------------------
# AI BACKEND MODE
# Options:
#   no_ai       - Rule-based extraction (regex, zero API cost)
#   local       - Local LLM via OpenAI-compatible endpoint (Ollama, LM Studio, Hermes, OpenCode)
#   groq        - Groq API with multi-key rotation (Llama 3.3 70B & Llama 4 Scout Vision)
#   gemini      - Google Gemini API (gemini-1.5-flash / gemini-2.0)
#   openai      - OpenAI API (gpt-4o, gpt-4o-mini)
#   antigravity - OpenAI-compatible gateway via Antigravity API
# ---------------------------------------------------------------
AI_MODE=groq

# ---------------------------------------------------------------
# LOCAL LLM (Ollama, LM Studio, llama.cpp, Hermes, OpenCode)
# ---------------------------------------------------------------
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-vl:7b
LOCAL_LLM_API_KEY=local-key
LOCAL_LLM_VISION_ENABLED=true

# ---------------------------------------------------------------
# GROQ API (Key Rotation Pool: up to 10 keys supported)
# Register free keys at https://console.groq.com
# ---------------------------------------------------------------
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# GOOGLE GEMINI API
# ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# ---------------------------------------------------------------
# OPENAI / ANTIGRAVITY
# ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set OPENAI_BASE_URL if pointing to Antigravity or custom gateway
OPENAI_BASE_URL=

# ---------------------------------------------------------------
# PATHS
# ---------------------------------------------------------------
DATA_DIR=Es Magico - AI Intern Assignment - Sample Pack
LABELLED_DIR=Es Magico - AI Intern Assignment - Sample Pack/labelled
UNLABELLED_DIR=Es Magico - AI Intern Assignment - Sample Pack/unlabelled
OUTPUTS_DIR=outputs

# ---------------------------------------------------------------
# TESSERACT OCR CONFIGURATION
# ---------------------------------------------------------------
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------------------------------------------------------------
# PIPELINE BEHAVIOR & TOLERANCE
# ---------------------------------------------------------------
ARITHMETIC_TOLERANCE=0.05
MAX_RETRIES=2
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
